# .env.example — copy to .env and fill in your keys
# Never commit .env to git

# Korea: DART Open API (free) — https://opendart.fss.or.kr/
DART_API_KEY=your_dart_api_key_here

# Japan: EDINET API (free) — https://disclosure2.edinet-fsa.go.jp/
EDINET_API_KEY=your_edinet_api_key_here

# US Macro data: FRED API (free) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Optional: SimFin Premium for deeper EU historical data
# SIMFIN_API_KEY=your_simfin_api_key_here

# Optional: Hugging Face token for pushing data/models to HF Hub
# HF_TOKEN=your_hf_token_here

# Optional: HuggingFace dataset repo ID — enables cloud mode in app_v2.py
# When set, the app loads data/models from HF Hub instead of local disk.
# Format: your-username/stock-screener-data
# HF_REPO=your-username/stock-screener-data
