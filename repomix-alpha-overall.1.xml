    "# \u2500\u2500 Section 9 Config \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "TOP_COMPOSITE_PCT  = 0.30   # candidate pool: top 30% composite score\n",
    "PIOTROSKI_MIN      = 7      # gate 1: Piotroski F-score \u2265 7\n",
    "ALTMAN_GREY_ZONE   = 1.81   # gate 2: Altman Z > 1.81 (grey-zone lower bound)\n",
    "FCF_YIELD_MIN      = 0.0    # gate 3: FCF yield > 0\n",
    "BENEISH_GATE       = -1.78  # gate 4: Beneish M-score < \u22121.78\n",
    "BETA_MAX_LEVER     = 1.0    # only apply leverage to names with beta_12m < 1.0\n",
    "MAX_LEVERAGE       = 2.0    # hard cap on leverage multiplier\n",
    "TOP_N_LEVERED      = 20     # final ranked output size\n"
   ]
