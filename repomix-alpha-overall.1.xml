   "source": [
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "print('\u2500\u2500 11B: Re-score picks with best-horizon calibration \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500')\n",
    "assert 'picks' in dir() and not picks.empty, \"Run Section 9 first\"\n",
    "assert 'hor_calibrations' in dir(), \"Run Section 11A first\"\n",
    "assert 'CAL_INTERCEPT' in dir(), \"Run Section 10A first\"\n",
    "\n",
    "# Build full calibration lookup including 1y\n",
    "full_cal = {'1y': {'intercept': CAL_INTERCEPT, 'slope': CAL_SLOPE, 'hor_years': 1.0}}\n",
    "full_cal.update(hor_calibrations)\n",
    "\n",
    "# For each pick compute implied annualised CAGR under each horizon\n",
    "disp_rows = []\n",
    "for _, row in picks.iterrows():\n",
    "    cs = row['composite_score']\n",
    "    r = {'label': row['label'], 'safety_tier': row['safety_tier'],\n",
    "         'composite_score': cs, 'beta_live': row.get('beta_live', float('nan')),\n",
    "         'leverage_x': row.get('leverage_x', 1.0)}\n",
    "    for h, d in full_cal.items():\n",
    "        est_ann = (d['intercept'] + d['slope'] * cs) * 100\n",
    "        r[f'CAGR_{h}_%'] = round(est_ann, 1)\n",
    "    disp_rows.append(r)\n",
    "\n",
    "cal_df = pd.DataFrame(disp_rows).set_index('label')\n",
    "\n",
    "# Best horizon = 3y (highest model AUC; \u2705 target met)\n",
    "cal_df['best_CAGR_%'] = cal_df['CAGR_3y_%']\n",
    "cal_df['levered_best_%'] = (cal_df['best_CAGR_%'] * cal_df['leverage_x']).round(1)\n",
    "\n",
    "tier_map2 = {1:'\ud83d\udfe2 1', 2:'\ud83d\udfe1 2', 3:'\ud83d\udd34 3', 4:'\u26ab 4'}\n",
