hac_var = gamma0
⋮----
cov = np.mean((x[lag:] - mu) * (x[:-lag] - mu))
hac_var += 2 * (1 - lag / (max_lags + 1)) * cov  # Bartlett kernel
hac_var = max(hac_var, 1e-12)
