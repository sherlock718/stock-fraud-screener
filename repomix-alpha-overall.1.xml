    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "print('\u2500\u2500 12A: Full-Universe Tier-1 Scan \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500')\n",
    "\n",
    "# \u2500\u2500 Load full parquet \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "full = pd.read_parquet(DATA / 'historical_dataset_clean.parquet')\n",
    "\n",
    "# \u2500\u2500 Keep latest annual row per ticker \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "full_ann = (\n",
    "    full[\n",
    "        (full['period_type'] == 'annual') &\n",
    "        (full['market'] == S12_MARKET) &\n",
    "        (full['fiscal_year'] >= S12_MIN_FISCAL_YR)\n",
    "    ]\n",
    "    .sort_values('fiscal_year', ascending=False)\n",
    "    .drop_duplicates(subset=['ticker'], keep='first')\n",
    "    .copy()\n",
    ")\n",
    "print(f'Universe: {len(full_ann):,} unique tickers (US annual, fiscal_year \u2265 {S12_MIN_FISCAL_YR})')\n",
    "\n",
    "# \u2500\u2500 Composite score (equal-weight rank, same signals as Section 5) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "sig_pool = ['ml_3y_oof','ml_1y_oof','ml_2y_oof','ml_6m_oof',\n",
    "            'value_composite','quality_composite','piotroski_f_score',\n",
    "            'alpha_value','alpha_quality']\n",
    "sigs = [c for c in sig_pool if c in full_ann.columns]\n",
    "comp = pd.Series(0.0, index=full_ann.index)\n",
    "for s in sigs:\n",
    "    r = full_ann[s].rank(pct=True)\n",
    "    comp[r.notna()] += r[r.notna()]\n",
    "full_ann['composite_score'] = (comp / len(sigs)).round(4)\n",
    "print(f'Composite built from {len(sigs)} signals: {sigs}')\n",
    "\n",
    "# \u2500\u2500 Safety gates \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "def _safety_gates_12(row):\n",
    "    gates = {\n",
    "        'piotroski': (pd.notna(row.get('piotroski_f_score')) and row['piotroski_f_score'] >= PIOTROSKI_MIN),\n",
    "        'altman':    (pd.notna(row.get('altman_z_score'))    and row['altman_z_score'] > ALTMAN_GREY_ZONE),\n",
    "        'fcf':       (pd.notna(row.get('fcf_yield'))         and row['fcf_yield'] > FCF_YIELD_MIN),\n",
    "        'beneish':   (pd.notna(row.get('beneish_m_score'))   and row['beneish_m_score'] < BENEISH_GATE),\n",
    "    }\n",
    "    n = sum(gates.values())\n",
    "    tier = 1 if n == 4 else (2 if n == 3 else (3 if n == 2 else 4))\n",
    "    return pd.Series({'gates_passed': n, 'safety_tier': tier})\n",
    "\n",
    "gate_cols = full_ann.apply(_safety_gates_12, axis=1)\n",
    "full_ann = pd.concat([full_ann, gate_cols], axis=1)\n",
    "\n",
    "# \u2500\u2500 Filter: Tier-1 + top composite \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "tier1 = full_ann[full_ann['safety_tier'] == 1].copy()\n",
    "comp_thresh = tier1['composite_score'].quantile(1 - S12_MIN_COMPOSITE)\n",
    "tier1 = tier1[tier1['composite_score'] >= comp_thresh].copy()\n",
    "tier1 = tier1.nlargest(S12_TOP_N, 'composite_score').reset_index(drop=True)\n",
    "\n",
    "print(f'\\nTier-1 candidates (before beta filter): {len(tier1)}')\n",
    "print(tier1[['ticker','fiscal_year','composite_score','piotroski_f_score',\n",
    "             'altman_z_score','beneish_m_score','fcf_yield']].to_string(index=False))\n"
