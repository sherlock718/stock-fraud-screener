sorted_pvals = pvalues.iloc[sorted_idx].values
bh_thresholds = np.arange(1, n + 1) / n * alpha
reject_sorted = sorted_pvals <= bh_thresholds
# Keep all rejections up to the largest k where p_(k) <= k/m * alpha
