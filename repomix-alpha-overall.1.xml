    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "print('\u2500\u2500 10B: Beta Fetch (yfinance) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500')\n",
    "\n",
    "# \u2500\u2500 Extract tickers from Section 9 picks \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "assert 'picks' in dir() and not picks.empty, \"Run Section 9 first to get picks\"\n",
    "\n",
    "raw_tickers = picks['label'].str.extract(r'^([A-Za-z0-9.]+)')[0].tolist()\n",
    "# Map Canadian/TSX tickers: .TO \u2192 -TO  (yfinance format)\n",
    "yf_tickers = [t.replace('.TO', '-TO').replace('.V', '-V') for t in raw_tickers]\n",
    "\n",
    "all_tickers = [BETA_BENCHMARK] + yf_tickers\n",
    "print(f'Fetching price data for {len(all_tickers)} tickers ({BETA_PERIOD} window)...')\n",
    "\n",
    "import yfinance as yf\n",
    "prices_raw = yf.download(all_tickers, period=BETA_PERIOD, progress=False, auto_adjust=True)\n",
    "close = prices_raw['Close'] if isinstance(prices_raw.columns, pd.MultiIndex) else prices_raw\n",
    "\n",
    "# \u2500\u2500 Compute daily returns \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "rets = close.pct_change().dropna(how='all')\n",
    "\n",
    "spy_ret = rets[BETA_BENCHMARK] if BETA_BENCHMARK in rets.columns else None\n",
    "if spy_ret is None:\n",
    "    print(f'WARNING: {BETA_BENCHMARK} data not available \u2014 beta will be NaN for all')\n",
    "\n",
    "# \u2500\u2500 Beta = cov(stock, bench) / var(bench) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "beta_map = {}\n",
    "n_ok, n_fail = 0, 0\n",
    "\n",
    "for raw_t, yf_t in zip(raw_tickers, yf_tickers):\n",
    "    if yf_t not in rets.columns or spy_ret is None:\n",
    "        beta_map[raw_t] = float('nan')\n",
    "        n_fail += 1\n",
    "        continue\n",
    "    s_ret  = rets[yf_t].dropna()\n",
    "    bench  = spy_ret.reindex(s_ret.index).dropna()\n",
    "    s_ret  = s_ret.reindex(bench.index)\n",
    "    if len(bench) < 60:          # need at least 60 trading days\n",
    "        beta_map[raw_t] = float('nan')\n",
    "        n_fail += 1\n",
    "        continue\n",
    "    cov  = np.cov(s_ret.values, bench.values)[0, 1]\n",
    "    var  = np.var(bench.values, ddof=1)\n",
    "    beta = cov / var if var > 0 else float('nan')\n",
    "    beta_map[raw_t] = round(beta, 3)\n",
    "    n_ok += 1\n",
    "\n",
    "print(f'Beta computed: {n_ok} OK / {n_fail} failed (NaN)')\n",
    "beta_series = pd.Series(beta_map)\n",
    "print('\\nBeta results:')\n",
    "for raw_t, b in beta_map.items():\n",
    "    bstr = f'{b:.2f}' if not (b != b) else 'NaN'\n",
    "    print(f'  {raw_t:<15} \u03b2 = {bstr}')\n",
    "\n",
    "# \u2500\u2500 Re-apply leverage with real betas \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "def _leverage_real(row, beta_map_in):\n",
    "    tier = int(str(row['safety_tier']).strip().split()[-1])\n",
    "    raw_t = row['label'].split(' ')[0]\n",
    "    beta = beta_map_in.get(raw_t, float('nan'))\n",
    "    if beta != beta:     # NaN \u2192 conservative default\n",
    "        beta = 1.0\n",
    "    beta = min(float(beta), 3.0)\n",
    "    if tier == 1:\n",
    "        if beta < 0.5:             return 2.00\n",
    "        elif beta < 0.8:           return 1.50\n",
    "        elif beta < BETA_MAX_LEVER: return 1.25\n",
    "        else:                      return 1.00\n",
    "    elif tier == 2:\n",
    "        return 1.10 if beta < BETA_MAX_LEVER else 1.00\n",
    "    return 1.00\n",
    "\n",
    "picks['beta_live'] = picks['label'].str.extract(r'^([A-Za-z0-9.]+)')[0].map(beta_map)\n",
    "picks['leverage_x'] = picks.apply(_leverage_real, axis=1, beta_map_in=beta_map)\n",
    "\n",
    "# \u2500\u2500 Recalculate with calibrated CAGR \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "assert 'CAL_INTERCEPT' in dir(), \"Run Section 10A (calibration) first\"\n",
    "\n",
    "picks['implied_cagr_%'] = ((CAL_INTERCEPT + CAL_SLOPE * picks['composite_score']) * 100).round(1)\n",
    "picks['levered_cagr_%'] = (picks['implied_cagr_%'] * picks['leverage_x']).round(1)\n",
    "picks['net_kelly_%']    = (picks['kelly_pct'] * picks['leverage_x']).round(2)\n",
    "\n",
    "print('\\n\u2500\u2500 Updated picks with real beta + calibrated CAGR \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500')\n",
    "show_up = [c for c in ['label','safety_tier','beta_live','leverage_x',\n",
    "                        'composite_score','implied_cagr_%','levered_cagr_%','net_kelly_%']\n",
    "           if c in picks.columns]\n",
    "tier_map_d = {1:'\ud83d\udfe2 1', 2:'\ud83d\udfe1 2', 3:'\ud83d\udd34 3', 4:'\u26ab 4'}\n",
    "disp = picks[show_up].copy()\n",
    "\n",
    "fmt2 = {\n",
    "    'composite_score': '{:.4f}',\n",
    "    'implied_cagr_%':  '{:.1f}%',\n",
    "    'levered_cagr_%':  '{:.1f}%',\n",
    "    'leverage_x':      '{:.2f}\u00d7',\n",
    "    'net_kelly_%':     '{:.2f}%',\n",
    "    'beta_live':       '{:.2f}',\n",
    "}\n",
    "fmt2 = {k: v for k, v in fmt2.items() if k in disp.columns}\n",
    "grad_u = [c for c in ['composite_score','levered_cagr_%'] if c in disp.columns]\n",
    "bar_u  = [c for c in ['leverage_x'] if c in disp.columns]\n",
    "bar_b  = [c for c in ['beta_live']  if c in disp.columns]\n",
    "\n",
    "styled_u = disp.style.format(fmt2, na_rep='\u2014')\n",
    "if grad_u:\n",
    "    styled_u = styled_u.background_gradient(subset=grad_u, cmap='RdYlGn')\n",
    "if bar_u:\n",
    "    styled_u = styled_u.bar(subset=bar_u, vmin=1.0, vmax=2.0, color='#5fa2dd')\n",
    "if bar_b:\n",
    "    styled_u = styled_u.bar(subset=bar_b, vmin=0.0, vmax=2.0, color='#f39c12')\n",
    "\n",
    "display(styled_u)\n",
    "\n",
    "# \u2500\u2500 Export updated picks \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "from datetime import date\n",
    "out_path = Path('..') / 'data' / f'leveraged_picks_calibrated_{date.today()}.csv'\n",
    "picks[show_up].to_csv(out_path, index=True)\n",
    "print(f'\\nExported calibrated picks \u2192 {out_path}')\n",
    "\n",
    "# \u2500\u2500 Liquidity summary \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "print('\\n\u2500\u2500 10C: Liquidity Flags \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500')\n",
    "print('Market classification (bid-ask spread proxy):')\n",
    "liq_rows = []\n",
    "for _, r in picks.iterrows():\n",
    "    raw_t = r['label'].split(' ')[0]\n",
    "    mkt   = str(r.get('market',''))\n",
    "    tier  = str(r.get('safety_tier',''))\n",
    "    beta  = r.get('beta_live', float('nan'))\n",
    "    # Heuristic: .V = TSX Venture (very illiquid), .TO = TSX (moderate), US = most liquid\n",
    "    if raw_t.endswith('-V') or '.V' in raw_t or 'V' in raw_t.split('.')[-1:]:\n",
    "        liq = '\ud83d\udd34 Very Low (TSX-V)'\n",
    "    elif '-TO' in raw_t or '.TO' in raw_t:\n",
    "        liq = '\ud83d\udfe1 Moderate (TSX)'\n",
    "    else:\n",
    "        liq = '\ud83d\udfe2 Higher (US Exchange)'\n",
    "    liq_rows.append({'ticker': raw_t, 'market': mkt, 'safety_tier': tier,\n",
    "                     'beta_live': beta, 'liquidity': liq})\n",
    "\n",
    "liq_df = pd.DataFrame(liq_rows)\n",
    "print(liq_df.to_string(index=False))\n",
    "print('\\nNote: Verify actual ADV (avg daily volume) before sizing any position.')\n",
    "print('      Target: position size < 1% of 20-day ADV to avoid market impact.')\n"
   ]
