    "            'alpha_value','alpha_quality']\n",
    "\n",
    "fig, axes = plt.subplots(len(MULTI_HOR_CONFIGS), 2, figsize=(13, 5 * len(MULTI_HOR_CONFIGS)))\n",
    "\n",
    "for idx, cfg in enumerate(MULTI_HOR_CONFIGS):\n",
    "    h        = cfg['horizon']\n",
    "    oof_col  = cfg['oof_col']\n",
    "    ret_col  = cfg['ret_col']\n",
    "    hor_yrs  = cfg['hor_years']\n",
    "\n",
    "    cal = cal_full[\n",
    "        (cal_full['period_type'] == 'annual') &\n",
    "        (cal_full['market'] == CAL_MARKET) &\n",
    "        cal_full[oof_col].notna() &\n",
    "        cal_full[ret_col].notna() &\n",
    "        cal_full['fiscal_year'].between(CAL_MIN_FISCAL_YR, CAL_MAX_FISCAL_YR)\n",
    "    ].copy()\n",
    "\n",
    "    # Build equal-weight rank composite using available signals\n",
    "    sigs = [c for c in sig_pool if c in cal.columns]\n",
    "    comp = pd.Series(0.0, index=cal.index)\n",
    "    for s in sigs:\n",
    "        r = cal[s].rank(pct=True)\n",
    "        comp[r.notna()] += r[r.notna()]\n",
    "    cal['cal_composite'] = (comp / len(sigs)).round(4)\n",
    "\n",
    "    # Winsorize returns (but CAGR-annualise first for multi-year horizons)\n",
    "    # Raw return \u2192 annualised: (1+r)^(1/hor_years) - 1\n",
    "    ann_ret = (1 + cal[ret_col].clip(-0.999)).pow(1 / hor_yrs) - 1\n",
    "    cal['ret_ann'] = wins(ann_ret, limits=[CAL_WINSORIZE, CAL_WINSORIZE])\n",
    "\n",
    "    mask = cal['cal_composite'].notna() & cal['ret_ann'].notna()\n",
    "    slope, intercept, r_val, p_val, _ = linregress(\n",
    "        cal.loc[mask, 'cal_composite'], cal.loc[mask, 'ret_ann'])\n",
    "    r2 = r_val ** 2\n",
    "\n",
    "    hor_calibrations[h] = {'intercept': intercept, 'slope': slope, 'r2': r2, 'p': p_val,\n",
    "                           'n': int(mask.sum()), 'hor_years': hor_yrs, 'ret_col': ret_col}\n",
    "\n",
    "    print(f'\\n  [{h}] annualised return = {intercept*100:.2f}% + composite \u00d7 {slope*100:.2f}%')\n",
    "    print(f'        R\u00b2={r2:.4f}  p={p_val:.1e}  n={mask.sum():,}  ({cal[\"fiscal_year\"].min()}\u2013{cal[\"fiscal_year\"].max()})')\n",
    "    print(f'        Implied annualised CAGR at key scores:')\n",
    "    for s in [0.60, 0.70, 0.80, 0.90]:\n",
    "        est = (intercept + slope * s) * 100\n",
    "        print(f'          composite={s:.2f}  \u2192 {est:.1f}% ann. CAGR  ({h})')\n",
    "\n",
    "    # Quintile chart\n",
    "    cal['q5'] = pd.qcut(cal['cal_composite'], 5, labels=['Q1','Q2','Q3','Q4','Q5'])\n",
    "    q_means = cal.groupby('q5', observed=True)['ret_ann'].mean() * 100\n",
    "    q_ns    = cal.groupby('q5', observed=True)['ret_ann'].count()\n",
    "\n",
    "    ax = axes[idx, 0]\n",
    "    colors_q = ['#e74c3c','#e67e22','#f1c40f','#2ecc71','#27ae60']\n",
    "    bars = ax.bar(q_means.index, q_means.values, color=colors_q, edgecolor='none', alpha=0.85)\n",
    "    ax.axhline(0, color='gray', linewidth=0.8)\n",
    "    for bar, n in zip(bars, q_ns):\n",
    "        ax.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.3,\n",
    "                f'n={n:,}', ha='center', va='bottom', fontsize=7)\n",
    "    ax.set_title(f'[{h}] Composite Quintile \u2192 Ann. Return')\n",
    "    ax.set_ylabel('Mean Ann. Return (%)')\n",
    "\n",
    "    # Scatter\n",
    "    ax = axes[idx, 1]\n",
    "    xs = cal.loc[mask, 'cal_composite'].values\n",
    "    ys = cal.loc[mask, 'ret_ann'].values * 100\n",
    "    ax.scatter(xs, ys, alpha=0.03, s=4, c='steelblue', rasterized=True)\n",
    "    x_line = np.linspace(0, 1, 100)\n",
    "    ax.plot(x_line, (intercept + slope * x_line) * 100, color='red', linewidth=2,\n",
    "            label=f'OLS  R\u00b2={r2:.3f}')\n",
    "    ax.set_xlabel('Composite Score')\n",
    "    ax.set_ylabel('Winsorized Ann. Return (%)')\n",
    "    ax.set_title(f'[{h}] Calibration Scatter')\n",
    "    ax.legend(fontsize=9)\n",
    "    ax.set_ylim(-100, 150)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# \u2500\u2500 Summary table \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "print('\\n\u2500\u2500 Summary: All Calibrated Horizons (incl. 1y from Section 10) \u2500\u2500\u2500\u2500\u2500\u2500')\n",
    "all_rows = [('1y', CAL_INTERCEPT, CAL_SLOPE, None, None, 31916, 1.0)]\n",
    "for h, d in hor_calibrations.items():\n",
    "    all_rows.append((h, d['intercept'], d['slope'], d['r2'], d['p'], d['n'], d['hor_years']))\n",
    "\n",
    "print(f\"{'Horizon':<8} {'Intercept':>10} {'Slope':>8} {'R\u00b2':>7} {'At 0.8 ann.':>12}\")\n",
    "print('\u2500' * 52)\n",
    "for row in sorted(all_rows, key=lambda x: x[6]):\n",
    "    h, ic, sl, r2, p, n, hy = row\n",
    "    at80 = (ic + sl * 0.80) * 100\n",
    "    r2s  = f'{r2:.4f}' if r2 else '0.0322*'\n",
    "    print(f'{h:<8} {ic*100:>10.2f}% {sl*100:>7.2f}% {r2s:>7} {at80:>11.1f}%')\n",
    "print('  * 1y R\u00b2 from Section 10')\n"
   ]
