    "    ax.set_xlabel('FY')\n",
    "\n",
    "plt.suptitle('Median Feature Value by Fiscal Year (drift check)', y=1.02)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-11",
   "metadata": {},
   "source": [
    "## 5. Signal vs ROI — preliminary correlations\n",
    "\n",
    "Which features are most correlated with 12-month forward return?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-12",
   "metadata": {},
   "outputs": [],
   "source": "label = 'forward_return_1y'\nroi_df = df[df[label].notna()].copy()\nroi_df[label] = roi_df[label].clip(-1, 3)  # winsorise extremes\n\n# Correlation with ROI\nfeature_cols = [\n    'beneish_score', 'piotroski_score', 'accruals_ratio', 'cfd_ratio',\n    'altman_score', 'ar_ratio', 'non_op_ratio',\n    'earnings_yield', 'return_on_capital', 'acquirers_multiple',\n    'gross_profitability', 'croic', 'roe', 'roa', 'fcf_yield',\n    'gross_margin', 'net_margin', 'debt_to_equity', 'current_ratio',\n    'pe_ratio', 'pb_ratio', 'ev_ebitda', 'ncav_ratio',\n]\nexisting = [c for c in feature_cols if c in roi_df.columns]\n\ncorrs = roi_df[existing + [label]].corr()[label].drop(label).sort_values()\n\nfig, ax = plt.subplots(figsize=(10, 7))\ncolors = ['#e74c3c' if v < 0 else '#2ecc71' for v in corrs.values]\nax.barh(corrs.index, corrs.values, color=colors, alpha=0.8)\nax.axvline(0, color='white', alpha=0.3)\nax.set_title(f'Pearson Correlation with 1Y Forward Return (n={len(roi_df):,})')\nax.set_xlabel('Correlation')\nplt.tight_layout()\nplt.show()"
  },
  {
   "cell_type": "markdown",
   "id": "cell-13",
   "metadata": {},
   "source": [
    "## 6. Fraud score vs forward return\n",
    "\n",
    "Key hypothesis: high fraud score → lower future returns"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-14",
   "metadata": {},
   "outputs": [],
   "source": "# Reconstruct a simple composite fraud score from signal flags already in the dataset.\n# This avoids importing from the pipeline (which won't be installed in Colab).\n# Weighted sum of: beneish_flag(20), piotroski_weak(10), accruals_flag(10), cfd_flag(10),\n#                  altman_flag(20), revenue_quality_flag(10), earnings_quality_flag(10)\ndef simple_fraud_score(row):\n    score = 0\n    score += 20 if row.get('beneish_flag') else 0\n    score += 10 if row.get('piotroski_weak') else 0\n    score += 10 if row.get('accruals_flag') else 0\n    score += 10 if row.get('cfd_flag') else 0\n    score += 20 if row.get('altman_flag') else 0\n    score += 10 if row.get('revenue_quality_flag') else 0\n    score += 10 if row.get('earnings_quality_flag') else 0\n    return score\n\ndf['fraud_score_approx'] = df.apply(simple_fraud_score, axis=1)\n\n# Bucket into fraud quartiles\nroi_df2 = df[df['forward_return_1y'].notna() & df['fraud_score_approx'].notna()].copy()\nroi_df2['fraud_quartile'] = pd.qcut(roi_df2['fraud_score_approx'], q=4,\n                                     labels=['Q1 Low Risk', 'Q2', 'Q3', 'Q4 High Risk'],\n                                     duplicates='drop')\n\navg_ret = roi_df2.groupby('fraud_quartile', observed=True)['forward_return_1y'].agg(['mean', 'median', 'count'])\n\nfig, ax = plt.subplots(figsize=(8, 5))\nax.bar(avg_ret.index, avg_ret['median'], color=['#2ecc71', '#f39c12', '#e67e22', '#e74c3c'], alpha=0.85)\nax.axhline(0, color='white', linestyle='--', alpha=0.4)\nax.set_title('Median 1Y Forward Return by Fraud Score Quartile')\nax.set_xlabel('Fraud Score Quartile')\nax.yaxis.set_major_formatter(mticker.PercentFormatter(xmax=1))\nplt.tight_layout()\nplt.show()\n\nprint(avg_ret)"
  }
 ],
