    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "assert 'composite_score' in df.columns, \"Run Section 5 first (composite_score required)\"\n",
    "\n",
    "lev_df = df.copy()\n",
    "\n",
    "# \u2500\u2500 Safety gate scoring \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "def _safety_gates(row):\n",
    "    gates = {\n",
    "        'piotroski': (pd.notna(row.get('piotroski_f_score')) and\n",
    "                      row['piotroski_f_score'] >= PIOTROSKI_MIN),\n",
    "        'altman':    (pd.notna(row.get('altman_z_score')) and\n",
    "                      row['altman_z_score'] > ALTMAN_GREY_ZONE),\n",
    "        'fcf':       (pd.notna(row.get('fcf_yield')) and\n",
    "                      row['fcf_yield'] > FCF_YIELD_MIN),\n",
    "        'beneish':   (pd.notna(row.get('beneish_m_score')) and\n",
    "                      row['beneish_m_score'] < BENEISH_GATE),\n",
    "    }\n",
    "    n = sum(gates.values())\n",
    "    tier = 1 if n == 4 else (2 if n == 3 else (3 if n == 2 else 4))\n",
    "    return pd.Series({'gates_passed': n, 'safety_tier': tier,\n",
    "                      **{f'g_{k}': int(v) for k, v in gates.items()}})\n",
    "\n",
    "gate_cols = lev_df.apply(_safety_gates, axis=1)\n",
    "lev_df = pd.concat([lev_df, gate_cols], axis=1)\n",
    "\n",
    "# \u2500\u2500 Filter to top-composite candidate pool \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "comp_thresh = lev_df['composite_score'].quantile(1 - TOP_COMPOSITE_PCT)\n",
    "lev_df = lev_df[lev_df['composite_score'] >= comp_thresh].copy()\n",
    "\n",
    "# \u2500\u2500 Leverage multiplier (tier \u00d7 beta) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "def _leverage(row):\n",
    "    tier = int(row['safety_tier'])\n",
    "    beta = float(row['beta_12m']) if pd.notna(row.get('beta_12m')) else 1.0\n",
    "    beta = min(beta, 3.0)\n",
    "    if tier == 1:\n",
    "        if beta < 0.5:             return 2.00\n",
    "        elif beta < 0.8:           return 1.50\n",
    "        elif beta < BETA_MAX_LEVER: return 1.25\n",
    "        else:                      return 1.00\n",
    "    elif tier == 2:\n",
    "        return 1.10 if beta < BETA_MAX_LEVER else 1.00\n",
    "    return 1.00\n",
    "\n",
    "lev_df['leverage_x'] = lev_df.apply(_leverage, axis=1)\n",
    "\n",
    "# \u2500\u2500 Implied CAGR: linear fit from backtest (8% at composite=0 \u2192 35% at 1.0) \u2500\u2500\n",
    "lev_df['implied_cagr_%'] = (8 + lev_df['composite_score'] * 27).round(1)\n",
    "lev_df['levered_cagr_%'] = (lev_df['implied_cagr_%'] * lev_df['leverage_x']).round(1)\n",
    "\n",
    "# \u2500\u2500 Net Kelly position size with leverage \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "lev_df['net_kelly_%'] = (lev_df['kelly_pct'] * lev_df['leverage_x']).round(2)\n",
    "\n",
    "# \u2500\u2500 Conviction rank: composite \u00d7 (gates/4) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "lev_df['conviction'] = (lev_df['composite_score'] * lev_df['gates_passed'] / 4).round(4)\n",
    "\n",
    "# \u2500\u2500 Final picks: Tier 1\u20133 only, ranked by conviction \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "picks = (\n",
    "    lev_df[lev_df['safety_tier'] <= 3]\n",
    "    .nlargest(TOP_N_LEVERED, 'conviction')\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "picks.index = range(1, len(picks) + 1)\n",
    "\n",
    "# \u2500\u2500 Summary \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "tier_colors = {1: '#2ecc71', 2: '#f39c12', 3: '#e74c3c', 4: '#95a5a6'}\n",
    "print(f\"\\n{'\u2550'*65}\")\n",
    "print('  SECTION 9 \u2014 High-Conviction Leveraged Portfolio')\n",
    "print(f\"{'\u2550'*65}\")\n",
    "print(f'  Candidate pool      : top {int(TOP_COMPOSITE_PCT*100)}% composite ({len(lev_df)} stocks)')\n",
    "print(f'  \ud83d\udfe2 Tier 1 (4/4 gates): {(lev_df[\"safety_tier\"]==1).sum()} stocks')\n",
    "print(f'  \ud83d\udfe1 Tier 2 (3/4 gates): {(lev_df[\"safety_tier\"]==2).sum()} stocks')\n",
    "print(f'  \ud83d\udd34 Tier 3 (2/4 gates): {(lev_df[\"safety_tier\"]==3).sum()} stocks')\n",
    "print(f'  Final output        : top {TOP_N_LEVERED} by conviction')\n",
    "print(f'\\n  Leverage rules:')\n",
    "print(f'    Tier-1, \u03b2<0.5  \u2192 2.0\u00d7   Tier-1, \u03b2<0.8  \u2192 1.5\u00d7')\n",
    "print(f'    Tier-1, \u03b2<1.0  \u2192 1.25\u00d7  Tier-2, \u03b2<1.0  \u2192 1.1\u00d7  Tier-3 \u2192 1\u00d7')\n",
    "\n",
    "# \u2500\u2500 Styled table \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "show_cols = [c for c in [\n",
    "    'label', 'market', 'fiscal_year', 'safety_tier',\n",
    "    'composite_score', 'implied_cagr_%', 'leverage_x', 'levered_cagr_%', 'net_kelly_%',\n",
    "    'piotroski_f_score', 'altman_z_score', 'beneish_m_score', 'fcf_yield',\n",
    "    'beta_12m', 'ml_3y_oof', 'alpha_value', 'alpha_quality',\n",
    "] if c in picks.columns]\n",
    "\n",
    "tier_map = {1: '\ud83d\udfe2 1', 2: '\ud83d\udfe1 2', 3: '\ud83d\udd34 3', 4: '\u26ab 4'}\n",
    "picks_disp = picks[show_cols].copy()\n",
    "if 'safety_tier' in picks_disp.columns:\n",
    "    picks_disp['safety_tier'] = picks_disp['safety_tier'].map(tier_map)\n",
    "\n",
    "fmt = {\n",
    "    'composite_score':  '{:.4f}',\n",
    "    'implied_cagr_%':   '{:.1f}%',\n",
    "    'levered_cagr_%':   '{:.1f}%',\n",
    "    'leverage_x':       '{:.2f}\u00d7',\n",
    "    'net_kelly_%':      '{:.2f}%',\n",
    "    'fcf_yield':        '{:.3f}',\n",
    "    'beta_12m':         '{:.2f}',\n",
    "    'ml_3y_oof':        '{:.3f}',\n",
    "    'altman_z_score':   '{:.2f}',\n",
    "    'beneish_m_score':  '{:.2f}',\n",
    "}\n",
    "fmt = {k: v for k, v in fmt.items() if k in picks_disp.columns}\n",
    "\n",
    "grad_cols = [c for c in ['composite_score', 'levered_cagr_%'] if c in picks_disp.columns]\n",
    "bar_col   = [c for c in ['leverage_x'] if c in picks_disp.columns]\n",
    "\n",
    "styled = picks_disp.style.format(fmt, na_rep='\u2014')\n",
    "if grad_cols:\n",
    "    styled = styled.background_gradient(subset=grad_cols, cmap='RdYlGn')\n",
    "if bar_col:\n",
    "    styled = styled.bar(subset=bar_col, vmin=1.0, vmax=2.0, color='#5fa2dd')\n",
    "\n",
    "display(styled)\n",
    "\n",
    "# \u2500\u2500 Chart \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Left: conviction map\n",
    "ax = axes[0]\n",
    "for tier_val, grp in lev_df.groupby('safety_tier'):\n",
    "    kp = grp['kelly_pct'].clip(lower=0.5).fillna(1) if 'kelly_pct' in grp else 1\n",
    "    ax.scatter(grp['composite_score'], grp['gates_passed'],\n",
    "               s=kp * 15, alpha=0.65,\n",
    "               c=tier_colors.get(tier_val, '#ccc'),\n",
    "               label=f'Tier {tier_val} ({len(grp)})')\n",
    "if not picks.empty and 'gates_passed' in picks.columns:\n",
    "    ax.scatter(picks['composite_score'], picks['gates_passed'],\n",
    "               s=90, marker='*', c='gold', edgecolors='#333', linewidth=0.5,\n",
    "               zorder=5, label='Selected')\n",
    "ax.set_xlabel('Composite Score')\n",
    "ax.set_ylabel('Safety Gates Passed (0\u20134)')\n",
    "ax.set_title('Conviction Map')\n",
    "ax.set_yticks([0,1,2,3,4])\n",
    "ax.set_yticklabels(['0','1','2','3','4 (all)'])\n",
    "ax.legend(fontsize=8)\n",
    "\n",
    "# Right: top picks levered vs unlevered CAGR\n",
    "ax = axes[1]\n",
    "if not picks.empty and 'implied_cagr_%' in picks.columns:\n",
    "    pp = picks.head(15).copy()\n",
    "    bcolors = [tier_colors.get(int(str(t).strip('\ud83d\udfe2\ud83d\udfe1\ud83d\udd34\u26ab ')), '#ccc')\n",
    "               for t in pp['safety_tier']] if 'safety_tier' in pp.columns else ['#5fa2dd']*len(pp)\n",
    "    levered  = pp['levered_cagr_%'] if 'levered_cagr_%' in pp.columns else pp['implied_cagr_%']\n",
    "    unlev    = pp['implied_cagr_%']\n",
    "    y = range(len(pp))\n",
    "    ax.barh(y, levered, color=bcolors, alpha=0.85, edgecolor='none', label='Levered')\n",
    "    ax.barh(y, unlev,   color='lightgray', alpha=0.6, edgecolor='none', label='Unlevered')\n",
    "    tick_labels = pp['label'].fillna(pp.get('ticker','')) if 'label' in pp.columns else pp.index\n",
    "    ax.set_yticks(list(y))\n",
    "    ax.set_yticklabels(list(tick_labels), fontsize=8)\n",
    "    ax.invert_yaxis()\n",
    "    ax.set_xlabel('Implied CAGR %')\n",
    "    ax.set_title('Top Picks \u2014 Levered vs Unlevered CAGR')\n",
    "    ax.legend(fontsize=8)\n",
    "\n",
    "plt.suptitle('Section 9 \u2014 High-Conviction Leveraged Portfolio', fontsize=11)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# \u2500\u2500 Export \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "from datetime import date\n",
    "out_path = Path('..') / 'data' / f'leveraged_picks_{date.today()}.csv'\n",
    "picks[show_cols].to_csv(out_path, index=True)\n",
    "print(f'\\nExported {len(picks)} picks \u2192 {out_path}')\n"
   ]
  },
