    "from scipy.stats import norm as _norm\n\nif df is not None and '1y' in fr:\n    ret_col = 'forward_return_1y'\n    top_feats = fr['1y'].head(8)['feature'].tolist()\n\n    fig, axes = plt.subplots(2, 4, figsize=(20, 8))\n    axes = axes.flatten()\n    for ax, feat in zip(axes, top_feats):\n        ic_map = _ic_series_by_year(df, feat, ret_col)\n        if len(ic_map) < 4:\n            ax.set_visible(False)\n            continue\n        vals = list(ic_map.values())\n        ax.hist(vals, bins=10, color='steelblue', edgecolor='white', alpha=0.8, density=True)\n        mu, sd = np.mean(vals), np.std(vals)\n        x = np.linspace(min(vals) - 0.05, max(vals) + 0.05, 200)\n        ax.plot(x, _norm.pdf(x, mu, sd), 'r-', linewidth=1.5)\n        ax.axvline(0, color='k', linewidth=0.6, linestyle='--')\n        ax.axvline(mu, color='orange', linewidth=1.2, linestyle=':')\n        ax.set_title(f'{feat[:30]}\\n\u03bc={mu:+.3f}  \u03c3={sd:.3f}', fontsize=9)\n        ax.grid(True, alpha=0.3)\n    plt.suptitle('Annual IC distribution (1y horizon) \u2014 top 8 factors', fontsize=13)\n    plt.tight_layout()\n    plt.show()\nelse:\n    print(\"Load the raw dataset and run 1y research first.\")\n"
   ]
