    "        ('Sharpe',               s4a.get('sharpe')),\n",
    "        ('Sortino',              s4a.get('sortino')),\n",
    "        ('Calmar',               s4a.get('calmar')),\n",
    "        ('Max Drawdown (%)',     s4a.get('max_drawdown_pct')),\n",
