   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-5",
   "metadata": {},
   "source": [
    "## 2. ROI distribution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-6",
   "metadata": {},
   "outputs": [],
   "source": "roi = df['forward_return_1y'].dropna()\nroi_clipped = roi.clip(-1, 3)  # clip extreme outliers for display\n\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\naxes[0].hist(roi_clipped, bins=80, color='#3498db', edgecolor='none', alpha=0.8)\naxes[0].axvline(0, color='white', linestyle='--', alpha=0.5)\naxes[0].axvline(roi.median(), color='#2ecc71', linestyle='-', label=f'Median {roi.median():.1%}')\naxes[0].set_title('1-Year Forward Return Distribution')\naxes[0].set_xlabel('Return (clipped at -100% / +300%)')\naxes[0].xaxis.set_major_formatter(mticker.PercentFormatter(xmax=1))\naxes[0].legend()\n\n# By year\nroi_by_year = df.groupby('fiscal_year')['forward_return_1y'].median()\naxes[1].bar(roi_by_year.index, roi_by_year.values, color='#f39c12', alpha=0.8)\naxes[1].axhline(0, color='white', linestyle='--', alpha=0.5)\naxes[1].set_title('Median 1-Year Return by Fiscal Year')\naxes[1].set_xlabel('Fiscal Year')\naxes[1].yaxis.set_major_formatter(mticker.PercentFormatter(xmax=1))\n\nplt.tight_layout()\nplt.show()\n\nprint(f\"Count: {len(roi):,}\")\nprint(f\"Mean:   {roi.mean():.1%}\")\nprint(f\"Median: {roi.median():.1%}\")\nprint(f\"Std:    {roi.std():.1%}\")\nprint(f\">0:     {(roi > 0).mean():.1%} of companies had positive 1y return\")\nprint(f\"Beat local market: {df['beat_local_market_1y'].mean():.1%} of companies beat their local index\")"
  },
  {
   "cell_type": "markdown",
   "id": "cell-7",
   "metadata": {},
   "source": [
    "## 3. Look-ahead bias audit\n",
    "\n",
    "Critical: we must verify that no future information leaked into the features.\n",
    "The filing date must be BEFORE the entry price date."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-8",
   "metadata": {},
   "outputs": [],
   "source": "# Check: filed_date should always be <= entry price date (which is filed_date + 0-10 days)\n# Check: no fiscal_year data should use prices from after that year ended\n\nhas_both = df[df['forward_return_1y'].notna() & df['filed_date'].notna()].copy()\nhas_both['filed_ts'] = pd.to_datetime(has_both['filed_date'])\nhas_both['year_end'] = has_both['fiscal_year'].apply(lambda y: pd.Timestamp(f'{y}-12-31'))\n\n# Filing should be after the fiscal year ended (10-K filed typically 60-90 days after FY end)\nearly_filings = has_both[has_both['filed_ts'] < has_both['year_end']]\nprint(f\"Total rows with forward return: {len(has_both):,}\")\nprint(f\"Rows where filing is BEFORE fiscal year end (potential bias): {len(early_filings):,}\")\nif len(early_filings) > 0:\n    print(\"\\nSample early filings (check these):\")\n    print(early_filings[['ticker', 'fiscal_year', 'filed_date', 'year_end']].head(10))\nelse:\n    print(\"✅ No look-ahead bias detected — all filings are after fiscal year end\")"
  },
  {
   "cell_type": "markdown",
   "id": "cell-9",
   "metadata": {},
   "source": [
    "## 4. Feature distributions over time\n",
    "\n",
    "Check for data drift — do the features look stable across years?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-10",
   "metadata": {},
   "outputs": [],
   "source": [
    "drift_features = ['beneish_score', 'altman_score', 'earnings_yield', 'gross_profitability', 'fcf_yield']\n",
    "drift_features = [f for f in drift_features if f in df.columns]\n",
