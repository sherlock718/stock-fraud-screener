   "source": [
    "## 7. Cumulative IC chart (IC momentum / regime drift)\n\nRunning sum of annual IC values over time.  \nA flattening or declining trend signals factor decay; a consistently rising line = stable alpha.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def _ic_series_by_year(df, feature, ret_col):\n    sub = df[df[ret_col].notna() & df[feature].notna()]\n    out = {}\n    for yr in sorted(sub['fiscal_year'].unique()):\n        g = sub[sub['fiscal_year'] == yr]\n        if len(g) < 30:\n            continue\n        c, _ = stats.spearmanr(g[feature], g[ret_col])\n        if not np.isnan(c):\n            out[yr] = c\n    return out\n\nif df is not None and '1y' in fr:\n    ret_col = 'forward_return_1y'\n    top_feats = fr['1y'].head(8)['feature'].tolist()\n\n    fig, axes = plt.subplots(2, 4, figsize=(20, 8))\n    axes = axes.flatten()\n    for ax, feat in zip(axes, top_feats):\n        ic_map = _ic_series_by_year(df, feat, ret_col)\n        if not ic_map:\n            ax.set_visible(False)\n            continue\n        years = sorted(ic_map)\n        cumulative = [sum(ic_map[y] for y in years[:i+1]) for i in range(len(years))]\n        ax.plot(years, cumulative, marker='o', linewidth=1.8, color='steelblue')\n        ax.axhline(0, color='k', linewidth=0.6, linestyle='--')\n        ax.set_title(feat[:35], fontsize=9)\n        ax.set_xlabel('Year')\n        ax.set_ylabel('Cum IC')\n        ax.grid(True, alpha=0.3)\n    plt.suptitle('Cumulative IC (1y horizon) \u2014 top 8 factors', fontsize=13)\n    plt.tight_layout()\n    plt.show()\nelse:\n    print(\"Load the raw dataset (df) in Section 3 and run 1y factor research first.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Quintile return bar charts (Alphalens-style)\n\nMean forward return per factor quintile, averaged across all years.  \nA clean Q1\u2192Q5 monotonic gradient = strong factor. Flat or inverted = weak/no signal.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def _quintile_rets(df, feature, ret_col, n_q=5):\n    sub = df[df[ret_col].notna() & df[feature].notna()].copy()\n    qrets = {q: [] for q in range(1, n_q + 1)}\n    for yr in sorted(sub['fiscal_year'].unique()):\n        g = sub[sub['fiscal_year'] == yr].copy()\n        if len(g) < n_q * 5:\n            continue\n        try:\n            g['_q'] = pd.qcut(g[feature], n_q, labels=False, duplicates='drop') + 1\n        except ValueError:\n            continue\n        for q in range(1, n_q + 1):\n            v = g[g['_q'] == q][ret_col].mean()\n            if pd.notna(v):\n                qrets[q].append(v)\n    return {q: float(np.mean(v)) for q, v in qrets.items() if v}\n\nif df is not None and '1y' in fr:\n    ret_col = 'forward_return_1y'\n    top_feats = fr['1y'].head(8)['feature'].tolist()\n    colors = ['#d73027','#fc8d59','#fee090','#91bfdb','#4575b4']\n\n    fig, axes = plt.subplots(2, 4, figsize=(20, 8))\n    axes = axes.flatten()\n    for ax, feat in zip(axes, top_feats):\n        qm = _quintile_rets(df, feat, ret_col)\n        if len(qm) < 3:\n            ax.set_visible(False)\n            continue\n        qs = sorted(qm)\n        vals = [qm[q] for q in qs]\n        bars = ax.bar([f'Q{q}' for q in qs], vals, color=colors[:len(qs)])\n        ax.axhline(0, color='k', linewidth=0.6)\n        ax.set_title(feat[:35], fontsize=9)\n        ax.set_ylabel('Mean return')\n        ax.grid(True, axis='y', alpha=0.3)\n        # annotate spread\n        if 1 in qm and max(qm) in qm:\n            spread = qm[max(qs)] - qm[1]\n            ax.set_xlabel(f'Q5\u2212Q1 = {spread:+.3f}', fontsize=8)\n    plt.suptitle('Quintile return analysis (1y horizon) \u2014 top 8 factors', fontsize=13)\n    plt.tight_layout()\n    plt.show()\nelse:\n    print(\"Load the raw dataset (df) and run 1y research first.\")\n"
   ]
  },
