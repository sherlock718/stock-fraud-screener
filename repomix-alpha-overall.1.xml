    "import warnings, numpy as np\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "print('\\n\u2500\u2500 12B: Live Beta Fetch \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500')\n",
    "\n",
    "assert 'tier1' in dir() and not tier1.empty, \"Run 12A first\"\n",
    "\n",
    "raw_tickers = tier1['ticker'].tolist()\n",
    "yf_tickers  = [t.replace('.TO', '-TO').replace('.V', '-V') for t in raw_tickers]\n",
    "\n",
    "import yfinance as yf\n",
    "all_dl = [S12_BETA_BENCH] + yf_tickers\n",
    "print(f'Downloading prices for {len(all_dl)} tickers ({S12_BETA_PERIOD})...')\n",
    "\n",
    "prices_raw = yf.download(all_dl, period=S12_BETA_PERIOD, progress=False, auto_adjust=True)\n",
    "close = prices_raw['Close'] if isinstance(prices_raw.columns, pd.MultiIndex) else prices_raw\n",
    "rets  = close.pct_change().dropna(how='all')\n",
    "\n",
    "spy_ret = rets.get(S12_BETA_BENCH)\n",
    "\n",
    "beta_map = {}\n",
    "for raw_t, yf_t in zip(raw_tickers, yf_tickers):\n",
    "    if yf_t not in rets.columns or spy_ret is None:\n",
    "        beta_map[raw_t] = float('nan'); continue\n",
    "    s_ret = rets[yf_t].dropna()\n",
    "    bench = spy_ret.reindex(s_ret.index).dropna()\n",
    "    s_ret = s_ret.reindex(bench.index)\n",
    "    if len(bench) < 60:\n",
    "        beta_map[raw_t] = float('nan'); continue\n",
    "    cov  = np.cov(s_ret.values, bench.values)[0, 1]\n",
    "    var  = np.var(bench.values, ddof=1)\n",
    "    beta_map[raw_t] = round(cov / var, 3) if var > 0 else float('nan')\n",
    "\n",
    "tier1['beta_live'] = tier1['ticker'].map(beta_map)\n",
    "\n",
    "# \u2500\u2500 Filter \u03b2 < S12_BETA_MAX \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "low_beta = tier1[tier1['beta_live'].fillna(999) < S12_BETA_MAX].copy()\n",
    "print(f'\\nTier-1 with \u03b2 < {S12_BETA_MAX}: {len(low_beta)} names')\n"
